<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/phpunit/bootstrap.php"
	colors="true"
    failOnWarning="true"
    failOnRisky="true"
>
    <testsuites>
        <testsuite name="Theme PHP tests">
            <directory>tests/phpunit/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
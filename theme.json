{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "templateParts": [
    {
      "name": "header",
      "title": "Site header",
      "area": "header"
    }
  ],
  "settings": {
    "layout": {
      "contentSize": "768px",
      "wideSize": "1280px"
    },

    "spacing": {
      "units": ["px", "rem", "vw", "%"],

      "spacingSizes": [
        {
          "name": "3XS",
          "slug": "3xs",
          "size": "clamp(0.3125rem, 0.3125rem + 0vw, 0.3125rem)"
        },
        {
          "name": "2XS",
          "slug": "2xs",
          "size": "clamp(0.5625rem, 0.5369rem + 0.1136vw, 0.625rem)"
        },
        {
          "name": "XS",
          "slug": "xs",
          "size": "clamp(0.875rem, 0.8494rem + 0.1136vw, 0.9375rem)"
        },
        {
          "name": "S",
          "slug": "s",
          "size": "clamp(1.125rem, 1.0739rem + 0.2273vw, 1.25rem)"
        },
        {
          "name": "M",
          "slug": "m",
          "size": "clamp(1.6875rem, 1.6108rem + 0.3409vw, 1.875rem)"
        },
        {
          "name": "L",
          "slug": "l",
          "size": "clamp(2.25rem, 2.1477rem + 0.4545vw, 2.5rem)"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "clamp(3.375rem, 3.2216rem + 0.6818vw, 3.75rem)"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "clamp(4.5rem, 4.2955rem + 0.9091vw, 5rem)"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "clamp(6.75rem, 6.4432rem + 1.3636vw, 7.5rem)"
        }
      ]
    },

    "border": {
      "radius": true,
      "radiusSizes": [
        { "name": "None", "slug": "none", "size": "0px" },
        { "name": "XS", "slug": "xs", "size": "0.125rem" },
        { "name": "S", "slug": "s", "size": "0.25rem" },
        { "name": "M", "slug": "m", "size": "0.5rem" },
        { "name": "L", "slug": "l", "size": "0.75rem" },
        { "name": "XL", "slug": "xl", "size": "1rem" },
        { "name": "2XL", "slug": "2xl", "size": "1.5rem" },
        { "name": "Full", "slug": "full", "size": "9999px" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "Work Sans",
          "slug": "display",
          "fontFamily": "\"Work Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Work Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./build/assets/fonts/WorkSans-Regular.woff2"]
            },
            {
              "fontFamily": "Work Sans",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": ["file:./build/assets/fonts/WorkSans-SemiBold.woff2"]
            },
            {
              "fontFamily": "Work Sans",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": ["file:./build/assets/fonts/WorkSans-Bold.woff2"]
            }
          ]
        },
        {
          "name": "Source Sans 3",
          "slug": "body",

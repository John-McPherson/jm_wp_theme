{
  "name": "jmc_custom_theme",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:assets": "mkdir -p build/assets && rsync -av --delete src/assets/ build/assets/",
    "build:styles": "sass src/scss/style.scss:build/css/style.css src/scss/editor-style.scss:build/css/editor-style.css --load-path=src/scss --no-source-map --style=compressed",
    "build:js": "wp-scripts build --output-path=build/js",
    "build": "npm run build:assets && npm run build:styles && npm run build:js",
    "start": "concurrently \"wp-scripts start --output-path=build/js\" \"sass --watch src/scss/style.scss:build/css/style.css src/scss/editor-style.scss:build/css/editor-style.css --load-path=src/scss\"",
    "package": "npm run build && rm -rf dist && mkdir -p dist && rsync -a build inc components templates theme.json style.css functions.php screenshot.png README.md dist/",
    "typecheck": "tsc --noEmit",
    "lint:php": "find . -type f -name \"*.php\" -not -path \"./node_modules/*\" -not -path \"./vendor/*\" -not -path \"./build/*\" -not -path \"./dist/*\" -print0 | xargs -0 -n1 php -l",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:styles": "wp-scripts lint-style",
    "lint:phpcs": "vendor/bin/phpcs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-McPherson/jm_wp_theme.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/John-McPherson/jm_wp_theme/issues"
  },
  "homepage": "https://github.com/John-McPherson/jm_wp_theme#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@wordpress/block-editor": "^15.22.0",
    "@wordpress/blocks": "^15.22.0",
    "@wordpress/components": "^38.0.0",
    "@wordpress/e2e-test-utils-playwright": "^1.53.0",
    "@wordpress/element": "^8.1.0",
    "@wordpress/env": "^11.13.0",
    "@wordpress/i18n": "^6.22.0",
    "@wordpress/icons": "^15.3.0",
    "@wordpress/scripts": "^32.4.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "sass": "^1.101.0",
    "typescript": "^6.0.3"
  }
}

{
  "name": "jmc_custom_theme",
  "version": "0.2.2",
  "description": "Custom Full Site Editing WordPress theme for AMC Electrical.",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build:assets": "mkdir -p build/assets && rsync -av --delete --exclude icons/ src/assets/ build/assets/",
    "build:icons": "node scripts/icons/build.js",
    "build:styles": "sass src/scss/style.scss:build/css/style.css src/scss/editor-style.scss:build/css/editor-style.css src/scss/layers/index.scss:build/css/layers.css --load-path=src/scss --no-source-map --style=compressed",
    "build:js": "wp-scripts build --output-path=build/js",
    "build": "npm run build:assets && npm run build:icons && npm run build:styles && npm run build:js",
    "start": "concurrently \"wp-scripts start --output-path=build/js\" \"sass --watch src/scss/style.scss:build/css/style.css src/scss/editor-style.scss:build/css/editor-style.css src/scss/layers/index.scss:build/css/layers.css --load-path=src/scss\"",
    "package": "npm run build && npm run i18n:make-pot && mkdir -p dist && rsync -a build inc components templates parts patterns styles languages theme.json style.css functions.php screenshot.png README.md dist/",
    "typecheck": "tsc --noEmit",
    "lint:php": "find . -type f -name \"*.php\" -not -path \"./node_modules/*\" -not -path \"./vendor/*\" -not -path \"./build/*\" -not -path \"./dist/*\" -not -path \"./.claude/*\" -print0 | xargs -0 -n1 php -l",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:styles": "wp-scripts lint-style",
    "lint:styles:fix": "wp-scripts lint-style --fix",
    "lint:phpcs": "vendor/bin/phpcs",
    "test:unit": "wp-scripts test-unit-js",
    "test:unit:coverage": "wp-scripts test-unit-js --coverage",
    "test:contrast": "node scripts/palettes/contrast.js",
    "schema:update": "curl -fsSL https://schemas.wp.org/trunk/block.json -o tests/unit/schemas/block.json",
    "env:start": "mkdir -p artifacts/e2e/php && wp-env start",
    "env:stop": "wp-env stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "i18n:pot": "npm run build:js && npm run i18n:make-pot",
    "i18n:make-pot": "rm -rf dist && vendor/bin/wp i18n make-pot . languages/jmc-theme.pot --domain=jmc-theme --exclude='node_modules,vendor,dist,artifacts,tests,scripts,.claude,build/assets,build/css,build/js/**/*.json,build/js/**/*.php'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-McPherson/jm_wp_theme.git"
  },
  "author": "John McPherson (https://github.com/John-McPherson)",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/John-McPherson/jm_wp_theme/issues"
  },
  "homepage": "https://github.com/John-McPherson/jm_wp_theme#readme",
  "prettier": "@wordpress/prettier-config",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^5.1.1",
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/block-serialization-default-parser": "^6.1.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/core-data": "^9.1.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/e2e-test-utils-playwright": "^3.2.0",
    "@wordpress/editor": "^16.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/eslint-plugin": "^28.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/icons": "^20.0.0",
    "@wordpress/plugins": "^8.1.0",
    "@wordpress/scripts": "^37.1.0",
    "@wordpress/server-side-render": "^7.1.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.74.0",
    "sass": "^1.101.0",
    "simple-icons": "^16.38.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

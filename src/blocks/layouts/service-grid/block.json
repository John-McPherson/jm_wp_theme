{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/service-grid",
  "version": "0.1.0",
  "title": "Service Grid",
  "category": "jmc-section",
  "icon": "screenoptions",
  "description": "Display introductory content alongside a responsive grid of the published services.",
  "keywords": ["services", "grid", "cards"],
  "attributes": {
    "palette": {
      "type": "string",
      "enum": ["default", "secondary", "inverse"],
      "default": "default"
    },
    "order": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "left"
    }
  },
  "allowedBlocks": ["jmc/column"],
  "example": {
    "attributes": {
      "palette": "default",
      "order": "left"
    },
    "innerBlocks": [
      {
        "name": "jmc/column",
        "innerBlocks": [
          {
            "name": "jmc/heading",
            "attributes": {
              "text": "Solutions built around you",
              "level": "2"
            }
          },
          {
            "name": "jmc/paragraph",
            "attributes": {
              "text": "Reliable electrical services for commercial and industrial projects."
            }
          }
        ]
      },
      {
        "name": "jmc/column",
        "innerBlocks": [{ "name": "jmc/service-list" }]
      }
    ],
    "viewportWidth": 1440
  },
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jm/text-with-image",
  "version": "0.1.0",
  "title": "Text with Image",
  "category": "jm-blocks",
  "icon": "layout",
  "description": "Text section with image",
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "palette": {
      "type": "string",
      "enum": ["default", "secondary", "inverse"],
      "default": "default"
    },
    "order": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "right"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "link": {
      "type": "object",
      "default": {
        "url": "",
        "label": "",
        "target": "",
        "rel": ""
      }
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "palette": "default",
      "order": "right",
      "imageUrl": "https://images.pexels.com/photos/8093682/pexels-photo-8093682.jpeg"
    },
    "innerBlocks": [
      {
        "name": "jm/paragraph",
        "attributes": {
          "text": "Label",
          "variant": "label"
        }
      },
      {
        "name": "jm/heading",
        "attributes": {
          "text": "Lorem ipsum dolor",
          "level": "1"
        }
      },
      {
        "name": "jm/paragraph",
        "attributes": {
          "text": "Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolorem distinctio quas beatae nisi numquam consectetur incidunt delectus soluta facere cupiditate magnam laudantium, quasi quo."
        }
      },
      {
        "name": "jm/button",
        "attributes": {
          "text": "Lorem ipsum"
        }
      }
    ],
    "viewportWidth": 1200
  },
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false
  },
  "textdomain": "text-with-image",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}

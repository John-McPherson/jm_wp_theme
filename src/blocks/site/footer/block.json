{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/footer",
  "version": "0.2.1",
  "title": "Footer",
  "category": "jmc-site",
  "icon": "align-full-width",
  "description": "The site footer container, with a selectable colour palette.",
  "attributes": {
    "palette": {
      "type": "string",
      "enum": ["default", "secondary", "inverse"],
      "default": "default"
    }
  },
  "allowedBlocks": ["jmc/trust-credentials", "jmc/footer-business", "jmc/footer-navigation", "jmc/footer-legal"],
  "example": {
    "attributes": {
      "palette": "inverse"
    },
    "innerBlocks": [
      {
        "name": "jmc/footer-business",
        "attributes": {
          "phone": "01234 567890"
        }
      }
    ]
  },
  "supports": {
    "html": false,
    "inserter": false,
    "multiple": false
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

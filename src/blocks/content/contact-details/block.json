{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/contact-details",
  "version": "0.2.1",
  "title": "Contact Details",
  "category": "jmc-content",
  "icon": "phone",
  "parent": ["jmc/column"],
  "description": "The business phone number, WhatsApp number, email address, opening hours and service area, from Settings → Business.",
  "attributes": {
    "showPhone": {
      "type": "boolean",
      "default": true
    },
    "showWhatsApp": {
      "type": "boolean",
      "default": true
    },
    "showEmail": {
      "type": "boolean",
      "default": true
    },
    "showHours": {
      "type": "boolean",
      "default": true
    },
    "showServiceArea": {
      "type": "boolean",
      "default": true
    }
  },
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

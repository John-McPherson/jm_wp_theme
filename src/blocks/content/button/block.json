{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/button",
  "version": "0.2.0",
  "title": "Button",
  "category": "jmc-content",
  "icon": "button",
  "description": "A reusable linked button.",
  "textdomain": "jmc-theme",

  "attributes": {
    "text": {
      "type": "string",
      "default": ""
    },
    "buttonType": {
      "type": "string",
      "enum": ["primary", "secondary"],
      "default": "primary"
    },
    "link": {
      "type": "object",
      "default": {
        "url": "",
        "opensInNewTab": false
      }
    },
    "linkType": {
      "type": "string",
      "enum": ["link", "phone", "email", "whatsapp"],
      "default": "link"
    },
    "emailSubject": {
      "type": "string",
      "default": ""
    },
    "emailBody": {
      "type": "string",
      "default": ""
    },
    "whatsappMessage": {
      "type": "string",
      "default": ""
    }
  },

  "variations": [
    {
      "name": "link",
      "title": "Button",
      "description": "Links to a page, URL, or telephone number.",
      "icon": "button",
      "attributes": {
        "linkType": "link"
      },
      "isDefault": true,
      "scope": ["block", "transform"],
      "isActive": ["linkType"]
    },
    {
      "name": "phone",
      "title": "Phone Button",
      "description": "Calls the business phone number set in Settings → Business.",
      "icon": "phone",
      "attributes": {
        "linkType": "phone"
      },
      "scope": ["block", "transform"],
      "isActive": ["linkType"]
    },
    {
      "name": "email",
      "title": "Email Button",
      "description": "Emails the business email address set in Settings → Business.",
      "icon": "email",
      "attributes": {
        "linkType": "email"
      },
      "scope": ["block", "transform"],
      "isActive": ["linkType"]
    },
    {
      "name": "whatsapp",
      "title": "WhatsApp Button",
      "description": "Opens a WhatsApp chat with the business WhatsApp number set in Settings → Business.",
      "icon": "format-chat",
      "attributes": {
        "linkType": "whatsapp"
      },
      "scope": ["block", "transform"],
      "isActive": ["linkType"]
    }
  ],

  "example": {
    "attributes": {
      "text": "Get a quote",
      "link": {
        "url": "#",
        "opensInNewTab": false
      }
    }
  },

  "ancestor": ["jmc/text-with-image", "jmc/hero", "jmc/buttons"],

  "supports": {
    "anchor": true,
    "html": false
  },

  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

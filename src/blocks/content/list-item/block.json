{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/list-item",
  "version": "0.2.1",
  "title": "List Item",
  "category": "jmc-content",
  "icon": "editor-ul",
  "description": "One point in a list. Supports bold, italic and links.",
  "attributes": {
    "text": {
      "type": "string",
      "role": "content",
      "default": ""
    }
  },
  "usesContext": [ "jmc/listStyle", "jmc/listIcon" ],
  "parent": [ "jmc/list" ],
  "example": {
    "attributes": {
      "text": "Fully qualified and insured"
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "reusable": false,
    "splitting": true
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jmc/credential",
	"version": "0.2.2",
	"title": "Credential",
	"category": "jmc-content",
	"icon": "awards",
	"description": "One accreditation, guarantee or review logo, with an optional link.",
	"keywords": [ "accreditation", "logo", "review", "trust" ],
	"attributes": {
		"imageId": {
			"type": "number",
			"default": 0
		},
		"link": {
			"type": "object",
			"default": {
				"url": "",
				"opensInNewTab": false
			}
		}
	},
	"parent": [ "jmc/credential-list" ],
	"example": {},
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false
	},
	"textdomain": "jmc-theme",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/service-card",
  "version": "0.1.0",
  "title": "Service Card",
  "category": "jm",
  "icon": "index-card",
  "description": "A linked service card with a predefined icon.",
  "textdomain": "jmc-theme",

  "attributes": {
    "icon": {
      "type": "string",

      "default": "domestic"
    },
    "link": {
      "type": "object",
      "default": {
        "url": "",
        "opensInNewTab": false,
        "target": "",
        "rel": ""
      }
    }
  },

  "ancestor": ["jmc/service-grid"],

  "allowedBlocks": ["jmc/heading", "jmc/paragraph"],

  "example": {
    "attributes": {
      "icon": "domestic",
      "link": {
        "url": "#",
        "opensInNewTab": false,
        "target": "",
        "rel": ""
      }
    },
    "innerBlocks": [
      {
        "name": "jmc/heading",
        "attributes": {
          "text": "Electrical Installations",
          "level": "3"
        }
      },
      {
        "name": "jmc/paragraph",
        "attributes": {
          "text": "Complete design and installation for commercial projects."
        }
      }
    ]
  },

  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "inserter": false
  },

  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

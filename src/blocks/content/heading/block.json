{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jm/heading",
  "version": "0.1.0",
  "title": "Heading",
  "category": "jm-blocks",
  "icon": "layout",
  "description": "Heading content block with heading",
  "attributes": {
    "text": {
      "type": "string",
      "default": "test"
    },
    "level": {
      "type": "string",
      "enum": ["1", "2", "3", "4", "5", "6"],
      "default": "2"
    },
    "lockLevel": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "text": "Example Heading",
      "level": 2
    }
  },
  "usesContext": ["jm/variant"],
  "supports": {
    "anchor": true,
    "className": true,
    "html": false,
    "inserter": false
  },
  "textdomain": "heading",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

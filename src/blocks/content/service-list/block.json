{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/service-list",
  "version": "0.1.0",
  "title": "Service List",
  "category": "jmc-blocks",
  "icon": "grid-view",
  "description": "Lists the published child pages of the Services page as linked cards.",
  "keywords": ["services", "cards"],
  "attributes": {
    "headingLevel": {
      "type": "string",
      "enum": ["2", "3", "4", "5", "6"],
      "default": "3"
    }
  },
  "ancestor": ["jmc/service-grid"],
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "inserter": false,
    "reusable": false
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

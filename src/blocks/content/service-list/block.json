{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jmc/service-list",
  "version": "0.2.2",
  "title": "Service List",
  "category": "jmc-content",
  "icon": "grid-view",
  "description": "Lists the published child pages of a parent page, or pages chosen in the block, as linked cards.",
  "keywords": ["services", "cards"],
  "attributes": {
    "headingLevel": {
      "type": "string",
      "enum": ["2", "3", "4", "5", "6"],
      "default": "3"
    },
    "source": {
      "type": "string",
      "enum": ["children", "chosen"],
      "default": "children"
    },
    "parentId": {
      "type": "number",
      "default": 0
    },
    "moreText": {
      "type": "string",
      "default": ""
    },
    "pageIds": {
      "type": "array",
      "items": { "type": "number" },
      "default": []
    }
  },
  "usesContext": ["postId", "postType"],
  "ancestor": ["jmc/service-grid"],
  "supports": {
    "anchor": true,
    "html": false,
    "inserter": false,
    "reusable": false
  },
  "textdomain": "jmc-theme",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}

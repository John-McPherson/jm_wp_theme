{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jm/paragraph",
  "version": "0.1.0",
  "title": "Paragraph",
  "category": "jm-blocks",
  "icon": "editor-paragraph",
  "description": "A reusable paragraph content block.",
  "textdomain": "jm-theme",

  "attributes": {
    "text": {
      "type": "string",
      "default": ""
    },
    "variant": {
      "type": "string",
      "enum": ["default", "label"],
      "default": "default"
    }
  },

  "variations": [
    {
      "name": "label",
      "title": "Label",
      "description": "Small supporting label text for headings and sections.",
      "attributes": {
        "variant": "label"
      },
      "scope": ["inserter", "block", "transform"],
      "isActive": ["variant"]
    }
  ],

  "example": {
    "attributes": {
      "text": "Example paragraph",
      "variant": "default"
    }
  },

  "usesContext": ["jm/variant"],

  "supports": {
    "anchor": true,
    "className": true,
    "html": false,
    "inserter": false
  },

  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
